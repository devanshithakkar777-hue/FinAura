# Copy to .env (never commit it).
POSTGRES_PASSWORD=change-me-to-a-long-random-string
PUBLIC_URL=https://app.yourdomain.com
# true behind HTTPS (required for secure cookies). false only for a local http trial.
COOKIE_SECURE=true
# Email (verification + password reset). e.g. smtps://user:pass@smtp.provider.com:465
SMTP_URL=
MAIL_FROM=FinAura <no-reply@yourdomain.com>
# Optional: live prices (Alpha Vantage) and LLM-written council summaries (Anthropic)
ALPHA_VANTAGE_KEY=
ANTHROPIC_API_KEY=
